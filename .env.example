# BSYSTEM Platform P0.x
# Copy to .env and replace every CHANGE_ME value before startup.

# Interface the stack publishes its ports on. The default keeps authentik,
# the Integration Core and the HUB reachable only from the host, which is what
# you want behind a TLS-terminating proxy. Widen it deliberately.
BIND_ADDRESS=127.0.0.1

POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
AUTHENTIK_SECRET_KEY=CHANGE_ME_USE_AT_LEAST_50_RANDOM_CHARACTERS

# authentik first-start bootstrap. Empty is the default and changes nothing:
# the /if/flow/initial-setup/ page creates the first administrator.
#
# On a host with no browser — a VM reached only over SSH — setting all three
# creates `akadmin` on the first start instead, and the token is an API token
# you can configure the rest with. The alternative is publishing an
# unauthenticated setup page on an interface somebody else can reach.
#
# **These are read on every start, not only the first.** A password left here
# is a static administrator credential in a running container's environment.
# Clear all three once the account exists; the preflight warns while they are
# set. See docs/DEPLOYMENT.md.
AUTHENTIK_BOOTSTRAP_EMAIL=
AUTHENTIK_BOOTSTRAP_PASSWORD=
AUTHENTIK_BOOTSTRAP_TOKEN=

# Least-privilege API token used by Integration Core for human-user
# administration. Leave empty to keep the HUB user directory read-only.
# Generate a high-entropy value locally, for example:
#   openssl rand -hex 32
# The same value is consumed by the authentik worker blueprint and by
# Integration Core; it is never sent to the browser.
BSYSTEM_AUTHENTIK_ADMIN_TOKEN=

# Browser-visible authentik issuer for the BSYSTEM-HUB OAuth2/OIDC provider.
# For local DEV use localhost; in STAGE/PROD use the real HTTPS URL.
VITE_OIDC_AUTHORITY=http://localhost:9000/application/o/bsystem-hub/
VITE_OIDC_CLIENT_ID=CHANGE_ME_AUTHENTIK_PUBLIC_CLIENT_ID

# Stage 1 canonical browser-visible native application origins. These are what
# a human's browser is redirected to and back from during OIDC login into
# Redmine, QA and Outline directly (not through the HUB), so the authentik
# blueprints in authentik/blueprints/custom/3x-bsystem-*.yaml build each
# provider's redirect_uri from these at reconciliation time.
#
# Keep real STAGE/PROD hostnames in the untracked .env, not in committed
# runbooks. These are distinct from:
#   * the server-side adapter URLs below (REDMINE_URL/OUTLINE_URL) — those are
#     what Integration Core calls out to as an upstream API client, never
#     what a browser is sent to;
#   * the legacy MODULE_*_LAUNCH_URL variables further down. Those exist only
#     to drive the HUB's per-module launcher button for modules the HUB
#     already knows how to embed/redirect to, not as a general public-URL
#     naming contract, and they MUST NOT be reused as the Stage 1 canonical
#     contract: they name a click target, not the origin an independent OIDC
#     provider redirects back to, and they carry query strings/paths
#     (`?oauth_provider=1`, `/auth/oidc`) that are launcher-specific, not part
#     of the origin.
# Safe documentation/test examples:
#   QA_PUBLIC_URL=https://qa.example
#   REDMINE_PUBLIC_URL=https://redmine.example
#   OUTLINE_PUBLIC_URL=https://kb.example
QA_PUBLIC_URL=
REDMINE_PUBLIC_URL=
OUTLINE_PUBLIC_URL=

# Optional business adapters. Leave URL empty to keep the adapter disabled.
ESPOCRM_URL=
ESPOCRM_API_KEY=
REDMINE_URL=
REDMINE_API_KEY=
OUTLINE_URL=
OUTLINE_API_KEY=

# Browser-visible application origins used by the HUB module launcher.
# Local DEV examples:
#   MODULE_REDMINE_LAUNCH_URL=http://localhost:18103/oauth?oauth_provider=1
#   MODULE_OUTLINE_LAUNCH_URL=http://localhost:18101/auth/oidc
#   MODULE_NEXTCLOUD_LAUNCH_URL=http://localhost:18102/apps/bsystem_sso/entry
# Use the real HTTPS application origins in STAGE/PROD.
#
# These pre-date, and are narrower than, the Stage 1 QA_PUBLIC_URL /
# REDMINE_PUBLIC_URL / OUTLINE_PUBLIC_URL variables above: they are a launcher
# click target for a module the HUB already embeds/redirects to, not the
# canonical origin an independent native-app OIDC provider is registered
# against. Do not repurpose them as that contract; new OIDC, deep-link or
# acceptance work must consume the *_PUBLIC_URL variables instead.
MODULE_REDMINE_LAUNCH_URL=
MODULE_OUTLINE_LAUNCH_URL=
MODULE_NEXTCLOUD_LAUNCH_URL=

# Stage 1 native application service identities (SVC-redmine, SVC-qa,
# SVC-outline). Each is a non-interactive authentik service_account in the
# BSYSTEM-Services group; the value here becomes its long-lived authentik API
# token, minted by authentik/blueprints/custom/40-bsystem-service-identities.yaml
# only when set (empty skips token creation, matching the
# BSYSTEM_AUTHENTIK_ADMIN_TOKEN pattern above). Each token is consumed
# entirely locally, by that one native app's own backend/plugin
# (redmine_bsystem_integration, the QA server, the Outline server) as the
# bearer credential it presents to Integration Core's /api/service/v1/*
# surface — Integration Core itself never reads this file. See
# docs/SERVICE-IDENTITIES.md for the permission each identity actually needs.
# Generate a high-entropy value locally, for example:
#   openssl rand -hex 32
SVC_REDMINE_TOKEN=
SVC_QA_TOKEN=
SVC_OUTLINE_TOKEN=

# Local token validation. Empty keeps the default, where the Integration Core
# asks authentik's UserInfo endpoint once per request — correct, and it makes
# authentik a synchronous dependency of every read.
#
# Setting the issuer switches to checking the signature locally, which requires
# authentik to issue JWT access tokens carrying `groups`. There is no fallback
# between the two: a Core configured for local validation refuses a token it
# cannot verify rather than asking UserInfo. See
# bsystem-integration-core/docs/AUTHENTICATION.md.
#
# Leaving OIDC_AUDIENCE empty accepts a token minted for any client of this
# issuer, and is logged as a warning at startup.
OIDC_ISSUER_URL=
OIDC_AUDIENCE=

# --- Stage ---------------------------------------------------------------
#
# Interface the STAGE stack publishes on. This is the variable that decides
# stage exposure: the stage overlay replaces every port mapping and reads this,
# and BIND_ADDRESS above does nothing there. Setting BIND_ADDRESS and expecting
# it to hold for stage is the mistake this line exists to prevent.
STAGE_PUBLISH_ADDRESS=127.0.0.1

# --- Optional tuning -----------------------------------------------------
#
# Every value below has a default and may be left commented out. They are
# listed because a setting nobody knows exists cannot be adjusted when an
# upstream is slow or a database is small, and scripts/check-config-docs.py
# keeps this section in step with what the stacks actually read.

# Browser-visible authentik userinfo endpoint the Integration Core validates
# tokens against. Override when authentik is not reached at its in-network name.
#AUTHENTIK_USERINFO_URL=http://authentik-server:9000/application/o/userinfo/

# Bounds one upstream attempt, and how long the circuit sheds load before it
# probes again. The E2E stack shortens both so a test can watch recovery.
#ADAPTER_TIMEOUT=10s
#ADAPTER_CIRCUIT_OPEN_FOR=30s

# PostgreSQL pool bounds for the Integration Core.
#DATABASE_MIN_CONNS=2
#DATABASE_MAX_CONNS=20

# debug, info, warn or error.
#LOG_LEVEL=info
