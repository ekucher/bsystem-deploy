# BSYSTEM Platform P0.1
# Copy to .env and replace every CHANGE_ME value before startup.

POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
AUTHENTIK_SECRET_KEY=CHANGE_ME_USE_AT_LEAST_50_RANDOM_CHARACTERS

# Browser-visible authentik issuer for the BSYSTEM-HUB OAuth2/OIDC provider.
# For local DEV use localhost; in STAGE/PROD use the real HTTPS URL.
VITE_OIDC_AUTHORITY=http://localhost:9000/application/o/bsystem-hub/
VITE_OIDC_CLIENT_ID=CHANGE_ME_AUTHENTIK_PUBLIC_CLIENT_ID
