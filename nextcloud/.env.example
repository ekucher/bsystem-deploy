# BSYSTEM Nextcloud
#
# Copy this file to .env and replace every CHANGE_ME value.
# Never commit nextcloud/.env.

# Compose
NEXTCLOUD_COMPOSE_PROJECT=bsystem-nextcloud-test

# Images
NEXTCLOUD_IMAGE=nextcloud:32-apache
NEXTCLOUD_DB_IMAGE=postgres:17

# Browser endpoint
NEXTCLOUD_BIND_ADDRESS=127.0.0.1
NEXTCLOUD_HTTP_PORT=18102
NEXTCLOUD_TRUSTED_DOMAINS=localhost

# PostgreSQL
NEXTCLOUD_POSTGRES_DB=nextcloud
NEXTCLOUD_POSTGRES_USER=nextcloud
NEXTCLOUD_POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD

# Initial local break-glass administrator.
# These variables are relevant during initial installation.
NEXTCLOUD_ADMIN_USER=bsystem-admin
NEXTCLOUD_ADMIN_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD

# Preserve the established runtime storage names.
NEXTCLOUD_DB_VOLUME=bsystem-nextcloud-test_nextcloud-db
NEXTCLOUD_DATA_VOLUME=bsystem-nextcloud-test_nextcloud-data

# Networks
NEXTCLOUD_INTERNAL_NETWORK=bsystem-nextcloud-test_internal
NEXTCLOUD_FRONTEND_NETWORK=bsystem-platform_frontend

# Health checks
NEXTCLOUD_DB_HEALTH_INTERVAL=10s
NEXTCLOUD_DB_HEALTH_TIMEOUT=5s
NEXTCLOUD_DB_HEALTH_RETRIES=10
NEXTCLOUD_DB_HEALTH_START_PERIOD=10s

NEXTCLOUD_HEALTH_INTERVAL=10s
NEXTCLOUD_HEALTH_TIMEOUT=5s
NEXTCLOUD_HEALTH_RETRIES=30
NEXTCLOUD_HEALTH_START_PERIOD=30s

# ---------------------------------------------------------------------------
# Nextcloud Office / Collabora CODE
# ---------------------------------------------------------------------------

# Pin this to the validated CODE release before production rollout.
COLLABORA_IMAGE=collabora/code:26.04.4.1.1

# Local DEV endpoint. In STAGE/PROD publish Collabora through the TLS proxy.
COLLABORA_BIND_ADDRESS=127.0.0.1
COLLABORA_HTTP_PORT=18104

# Browser-visible URL used by Nextcloud Office.
COLLABORA_PUBLIC_URL=http://localhost:18104

# WOPI callback host accepted by Collabora.
# Nextcloud Office sends WOPI requests to the internal Docker hostname.
COLLABORA_ALIASGROUP1=http://nextcloud

# Browser-visible host advertised by Collabora discovery.
# Value intentionally has no URL scheme; this is CODE server_name syntax.
COLLABORA_SERVER_NAME=localhost:18104

# Local HTTP test mode.
# STAGE/PROD must use HTTPS and appropriate TLS/reverse-proxy settings.
COLLABORA_EXTRA_PARAMS=--o:ssl.enable=false --o:mount_jail_tree=false

# Health checks
COLLABORA_HEALTH_INTERVAL=10s
COLLABORA_HEALTH_TIMEOUT=5s
COLLABORA_HEALTH_RETRIES=30
COLLABORA_HEALTH_START_PERIOD=60s
