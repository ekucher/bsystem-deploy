# Redmine runtime configuration.
# Copy to redmine.env, keep mode 0600, and replace every CHANGE_ME value.
# Never commit redmine.env.

POSTGRES_USER=redmine
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=redmine

REDMINE_DB_POSTGRES=redmine-postgres
REDMINE_DB_PORT=5432
REDMINE_DB_USERNAME=redmine
REDMINE_DB_PASSWORD=CHANGE_ME_USE_THE_SAME_PASSWORD_AS_POSTGRES_PASSWORD
REDMINE_DB_DATABASE=redmine

REDMINE_SECRET_KEY_BASE=CHANGE_ME_USE_A_LONG_RANDOM_SECRET
BSYSTEM_OIDC_CLIENT_SECRET=CHANGE_ME_AUTHENTIK_CLIENT_SECRET
